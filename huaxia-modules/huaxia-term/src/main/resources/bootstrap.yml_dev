spring:
  application:
    name: huaxia-term
  profiles:
    active: dev
  cloud:
    nacos:
      discovery:
        namespace: HuaxiaYidianTong
        server-addr: localhost:8848
        group: DEFAULT_GROUP
      config:
        namespace: HuaxiaYidianTong
        server-addr: localhost:8848
        group: DEFAULT_GROUP
        file-extension: yml
        shared-configs:
          - data-id: huaxia-term-dev.yml
            group: DEFAULT_GROUP
            refresh: true